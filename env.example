# Copy to .env (same folder as server.py). Never commit .env or share it.
GNANI_API_KEY=
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_STT_MODEL=prisma-v3.0
QC_API_KEY=change-me
OTP_DEMO=1

# Microphone needs HTTPS or localhost. For phones/LAN devices run with HTTPS=1 (pip install cryptography)
# HTTPS=1

# If Gnani still says "blocked ... browser signature", set a browser-like agent:
# GNANI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
